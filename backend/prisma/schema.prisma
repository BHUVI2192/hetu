generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

enum UserStatus { ACTIVE INACTIVE SUSPENDED }
enum UploadStatus { PENDING UPLOADING QUEUED PARSING COMPLETED FAILED CANCELLED }
enum AnalysisStatus { QUEUED RUNNING COMPLETED FAILED CANCELLED }
enum Severity { TRACE DEBUG INFO WARN ERROR FATAL UNKNOWN }
enum EventCategory { ERROR DEPLOYMENT CONFIGURATION PERFORMANCE SECURITY NETWORK DATABASE INFRASTRUCTURE APPLICATION UNKNOWN }
enum RecommendationPriority { CRITICAL HIGH MEDIUM LOW }
enum ChatRole { USER ASSISTANT SYSTEM }

model User { id String @id @default(uuid()) @db.Uuid; fullName String @map("full_name"); email String @unique; passwordHash String? @map("password_hash"); avatarUrl String? @map("avatar_url"); status UserStatus @default(ACTIVE); lastLogin DateTime? @map("last_login"); createdAt DateTime @default(now()) @map("created_at"); updatedAt DateTime @updatedAt @map("updated_at"); deletedAt DateTime? @map("deleted_at"); workspaces Workspace[]; chatSessions ChatSession[]; auditLogs AuditLog[]; @@map("users") }
model Workspace { id String @id @default(uuid()) @db.Uuid; ownerId String @map("owner_id") @db.Uuid; name String; description String?; createdAt DateTime @default(now()) @map("created_at"); updatedAt DateTime @updatedAt @map("updated_at"); deletedAt DateTime? @map("deleted_at"); owner User @relation(fields:[ownerId],references:[id]); projects Project[]; @@index([ownerId]); @@map("workspaces") }
model Project { id String @id @default(uuid()) @db.Uuid; workspaceId String @map("workspace_id") @db.Uuid; name String; description String?; environment String?; tags Json? @default("[]"); createdAt DateTime @default(now()) @map("created_at"); updatedAt DateTime @updatedAt @map("updated_at"); deletedAt DateTime? @map("deleted_at"); workspace Workspace @relation(fields:[workspaceId],references:[id]); uploads Upload[]; analyses Analysis[]; @@index([workspaceId]); @@map("projects") }
model Upload { id String @id @default(uuid()) @db.Uuid; projectId String @map("project_id") @db.Uuid; uploadStatus UploadStatus @default(PENDING) @map("upload_status"); totalFiles Int @default(0) @map("total_files"); totalSize BigInt @default(0) @map("total_size"); completedAt DateTime? @map("completed_at"); createdAt DateTime @default(now()) @map("created_at"); project Project @relation(fields:[projectId],references:[id]); files UploadedFile[]; parsedEvents ParsedEvent[]; analyses Analysis[]; @@index([projectId]); @@map("uploads") }
model UploadedFile { id String @id @default(uuid()) @db.Uuid; uploadId String @map("upload_id") @db.Uuid; filename String; mimeType String? @map("mime_type"); storagePath String @map("storage_path"); size BigInt @default(0); createdAt DateTime @default(now()) @map("created_at"); upload Upload @relation(fields:[uploadId],references:[id]); @@map("uploaded_files") }
model ParsedEvent { id String @id @default(uuid()) @db.Uuid; uploadId String @map("upload_id") @db.Uuid; timestamp DateTime?; service String?; severity Severity @default(INFO); message String; sourceFile String? @map("source_file"); lineNumber Int? @map("line_number"); metadata Json? @default("{}"); createdAt DateTime @default(now()) @map("created_at"); upload Upload @relation(fields:[uploadId],references:[id]); events Event[]; @@index([uploadId]); @@map("parsed_events") }
model Event { id String @id @default(uuid()) @db.Uuid; parsedEventId String @map("parsed_event_id") @db.Uuid; category EventCategory @default(UNKNOWN); confidence Decimal @default(0) @db.Decimal(5,2); title String; description String?; createdAt DateTime @default(now()) @map("created_at"); parsedEvent ParsedEvent @relation(fields:[parsedEventId],references:[id]); timelineEvents TimelineEvent[]; @@map("events") }
model Analysis { id String @id @default(uuid()) @db.Uuid; projectId String @map("project_id") @db.Uuid; uploadId String @map("upload_id") @db.Uuid; status AnalysisStatus @default(QUEUED); overallConfidence Decimal? @map("overall_confidence") @db.Decimal(5,2); summary String?; aiModel String? @map("ai_model"); tokensUsed Int? @map("tokens_used"); completedAt DateTime? @map("completed_at"); createdAt DateTime @default(now()) @map("created_at"); project Project @relation(fields:[projectId],references:[id]); upload Upload @relation(fields:[uploadId],references:[id]); timelineEvents TimelineEvent[]; dependencyNodes DependencyNode[]; dependencyEdges DependencyEdge[]; evidenceNodes EvidenceNode[]; hypotheses Hypothesis[]; rootCauses RootCause[]; recommendations Recommendation[]; reports Report[]; chatSessions ChatSession[]; @@index([projectId]); @@map("analyses") }
model TimelineEvent { id String @id @default(uuid()) @db.Uuid; analysisId String @map("analysis_id") @db.Uuid; eventId String @map("event_id") @db.Uuid; sequenceNumber Int @map("sequence_number"); occurredAt DateTime @map("occurred_at"); createdAt DateTime @default(now()) @map("created_at"); analysis Analysis @relation(fields:[analysisId],references:[id]); event Event @relation(fields:[eventId],references:[id]); @@map("timeline_events") }
model DependencyNode { id String @id @default(uuid()) @db.Uuid; analysisId String @map("analysis_id") @db.Uuid; nodeName String @map("node_name"); nodeType String @map("node_type"); metadata Json? @default("{}"); analysis Analysis @relation(fields:[analysisId],references:[id]); @@map("dependency_nodes") }
model DependencyEdge { id String @id @default(uuid()) @db.Uuid; analysisId String @map("analysis_id") @db.Uuid; sourceNodeId String @map("source_node") @db.Uuid; targetNodeId String @map("target_node") @db.Uuid; relationship String; weight Decimal @default(1) @db.Decimal(5,2); analysis Analysis @relation(fields:[analysisId],references:[id]); @@map("dependency_edges") }
model EvidenceNode { id String @id @default(uuid()) @db.Uuid; analysisId String @map("analysis_id") @db.Uuid; evidenceType String @map("evidence_type"); title String; description String?; confidence Decimal @default(0) @db.Decimal(5,2); metadata Json? @default("{}"); analysis Analysis @relation(fields:[analysisId],references:[id]); sourceEdges EvidenceEdge[] @relation("SourceEv"); targetEdges EvidenceEdge[] @relation("TargetEv"); @@map("evidence_nodes") }
model EvidenceEdge { id String @id @default(uuid()) @db.Uuid; sourceNodeId String @map("source_node") @db.Uuid; targetNodeId String @map("target_node") @db.Uuid; relationship String; confidence Decimal @default(0) @db.Decimal(5,2); sourceNode EvidenceNode @relation("SourceEv",fields:[sourceNodeId],references:[id]); targetNode EvidenceNode @relation("TargetEv",fields:[targetNodeId],references:[id]); @@map("evidence_edges") }
model Hypothesis { id String @id @default(uuid()) @db.Uuid; analysisId String @map("analysis_id") @db.Uuid; hypothesis String; explanation String?; confidence Decimal @default(0) @db.Decimal(5,2); rank Int @default(0); evidence Json? @default("[]"); analysis Analysis @relation(fields:[analysisId],references:[id]); rootCauses RootCause[]; @@map("hypotheses") }
model RootCause { id String @id @default(uuid()) @db.Uuid; analysisId String @map("analysis_id") @db.Uuid; hypothesisId String @map("hypothesis_id") @db.Uuid; explanation String; confidence Decimal @default(0) @db.Decimal(5,2); analysis Analysis @relation(fields:[analysisId],references:[id]); hypothesis Hypothesis @relation(fields:[hypothesisId],references:[id]); @@map("root_causes") }
model Recommendation { id String @id @default(uuid()) @db.Uuid; analysisId String @map("analysis_id") @db.Uuid; category String; recommendation String; priority RecommendationPriority @default(MEDIUM); impact String?; effort String?; analysis Analysis @relation(fields:[analysisId],references:[id]); @@map("recommendations") }
model Report { id String @id @default(uuid()) @db.Uuid; analysisId String @map("analysis_id") @db.Uuid; reportType String @map("report_type"); content String?; generatedAt DateTime @default(now()) @map("generated_at"); analysis Analysis @relation(fields:[analysisId],references:[id]); @@map("reports") }
model ChatSession { id String @id @default(uuid()) @db.Uuid; analysisId String @map("analysis_id") @db.Uuid; userId String @map("user_id") @db.Uuid; title String?; createdAt DateTime @default(now()) @map("created_at"); analysis Analysis @relation(fields:[analysisId],references:[id]); user User @relation(fields:[userId],references:[id]); messages ChatMessage[]; @@map("chat_sessions") }
model ChatMessage { id String @id @default(uuid()) @db.Uuid; sessionId String @map("session_id") @db.Uuid; role ChatRole; message String; tokensUsed Int? @map("tokens_used"); createdAt DateTime @default(now()) @map("created_at"); session ChatSession @relation(fields:[sessionId],references:[id]); @@index([sessionId]); @@map("chat_messages") }
model AuditLog { id String @id @default(uuid()) @db.Uuid; userId String? @map("user_id") @db.Uuid; action String; resourceType String @map("resource_type"); resourceId String? @map("resource_id") @db.Uuid; metadata Json? @default("{}"); createdAt DateTime @default(now()) @map("created_at"); user User? @relation(fields:[userId],references:[id]); @@map("audit_logs") }
model Notification { id String @id @default(uuid()) @db.Uuid; userId String @map("user_id") @db.Uuid; type String; title String; message String; read Boolean @default(false); createdAt DateTime @default(now()) @map("created_at"); @@index([userId]); @@map("notifications") }
